      "deliverable": "Data model + basic UI structure",
      "estimate": "2 hours"
    },
    {
      "phase": 2,
      "deliverable": "Task creation & display",
      "estimate": "2 hours"
    },
    {
      "phase": 3,
      "deliverable": "Timer functionality",
      "estimate": "2 hours"
    },
    {
      "phase": 4,
      "deliverable": "Summary dashboard",
      "estimate": "1 hour"
    },
    {
      "phase": 5,
      "deliverable": "Filters & sorting",
      "estimate": "1 hour"
    },
    {
      "phase": 6,
      "deliverable": "LocalStorage persistence",
      "estimate": "1 hour"
    },
    {
      "phase": 7,
      "deliverable": "Styling & polish",
      "estimate": "2 hours"
    },
    {
      "phase": 8,
      "deliverable": "Testing & bug fixes",
      "estimate": "1 hour"
    }
  ],
  "totalEstimate": "12 hours"
}